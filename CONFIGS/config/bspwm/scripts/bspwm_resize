#!/usr/bin/env bash

mode="$1"      # expand o contract
direction="$2" # west, south, north, east
step=50

if bspc query -N -n focused.floating > /dev/null; then
    # ── MODO FLOTANTE: Mueve bordes individuales ──
    if [ "$mode" = "expand" ]; then
        case "$direction" in
            west)  bspc node -z left -$step 0 ;;
            south) bspc node -z bottom 0 $step ;;
            north) bspc node -z top 0 -$step ;;
            east)  bspc node -z right $step 0 ;;
        esac
    else # contract (con Shift)
        case "$direction" in
            west)  bspc node -z right -$step 0 ;;
            south) bspc node -z top 0 $step ;;
            north) bspc node -z bottom 0 -$step ;;
            east)  bspc node -z left $step 0 ;;
        esac
    fi
else
    # ── MODO TILED (MOSAICO): Mueve la frontera compartida ──
    if [ "$mode" = "expand" ]; then
        case "$direction" in
            west)  bspc node -z right -$step 0 || bspc node -z left -$step 0 ;;
            south) bspc node -z bottom 0 $step || bspc node -z top 0 $step ;;
            north) bspc node -z top 0 -$step   || bspc node -z bottom 0 -$step ;;
            east)  bspc node -z right $step 0  || bspc node -z left $step 0 ;;
        esac
    else # contract (con Shift)
        case "$direction" in
            west)  bspc node -z left $step 0    || bspc node -z right $step 0 ;;
            south) bspc node -z bottom 0 -$step || bspc node -z top 0 -$step ;;
            north) bspc node -z top 0 $step     || bspc node -z bottom 0 $step ;;
            east)  bspc node -z right -$step 0  || bspc node -z left -$step 0 ;;
        esac
    fi
fi