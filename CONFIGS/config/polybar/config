;;==========================================================
;;  Polybar Configuration for KaliPWM (branch: design_changes)
;;  Theme: Neon Fuchsia & Celeste Cyberpunk
;;  Workspace Style: PACMAN
;;==========================================================

[colors]
background = #0a0a0c
background-alt = #141417
background-chip = #1a1a1f
foreground = #ffffff
foreground-alt = #a0aec0
fuchsia = #ff2cf1
celeste = #00f0ff
alert = #ff3366
disabled = #5c6370

[bar/main]
width = 100%
height = 34pt
radius = 10
offset-x = 0
offset-y = 0
fixed-center = true
bottom = false

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 3pt
line-color = ${colors.fuchsia}

border-size = 2pt
border-color = ${colors.fuchsia}

padding-left = 2
padding-right = 2
module-margin = 1

font-0 = "JetBrainsMono Nerd Font 10:style=Bold:size=10;3"
font-1 = "Feather:size=12;3"
font-2 = "Font Awesome 6 Free Solid:size=11;3"
font-3 = "JetBrainsMono Nerd Font:size=14;4"

modules-left = target_ip date
modules-center = bspwm
modules-right = cpu memory pulseaudio network battery powermenu

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

wm-restack = bspwm

[module/bspwm]
type = internal/bspwm
pin-workspaces = true
inline-mode = false
enable-click = true
enable-scroll = true
reverse-scroll = false

format = <label-state> <label-mode>

label-focused = 󰮯
label-focused-background = ${colors.fuchsia}
label-focused-foreground = #000000
label-focused-underline= ${colors.celeste}
label-focused-padding = 2

label-occupied = 󰊠
label-occupied-background = ${colors.background-chip}
label-occupied-foreground = ${colors.celeste}
label-occupied-padding = 2

label-urgent = %name%!
label-urgent-background = ${colors.alert}
label-urgent-padding = 2

label-empty = •
label-empty-foreground = ${colors.disabled}
label-empty-padding = 1


[module/target_ip]
type = custom/script
exec = ~/.config/polybar/scripts/target_to_hack.sh
interval = 2
format-prefix = "🎯 "
format-prefix-foreground = ${colors.fuchsia}
format-background = ${colors.background-chip}
format-padding = 2
label = %output%

[module/title]
type = internal/xwindow
format = <label>
format-background = ${colors.background-chip}
format-foreground = ${colors.celeste}
format-padding = 2
label = " %title:0:30:...%"
label-empty = " Desktop"

[module/date]
type = internal/date
interval = 1.0
date = %A, %d %b
time = %H:%M:%S
format = <label>
format-prefix = " "
format-prefix-foreground = ${colors.fuchsia}
format-background = ${colors.background-chip}
format-foreground = ${colors.foreground}
format-padding = 2
label = %date% %time%

[module/cpu]
type = internal/cpu
interval = 2
format-prefix = " "
format-prefix-foreground = ${colors.celeste}
format-background = ${colors.background-chip}
format-padding = 2
label = CPU %percentage:2%%

[module/memory]
type = internal/memory
interval = 2
format-prefix = " "
format-prefix-foreground = ${colors.fuchsia}
format-background = ${colors.background-chip}
format-padding = 2
label = RAM %percentage_used:2%%

[module/pulseaudio]
type = internal/pulseaudio
format-volume = <ramps> <label-volume>
format-volume-background = ${colors.background-chip}
format-volume-padding = 2
label-volume = %percentage%%
label-volume-foreground = ${colors.foreground}

label-muted = "󰝟 Muted"
label-muted-background = ${colors.background-chip}
label-muted-foreground = ${colors.alert}
label-muted-padding = 2

ramps-0 = ""
ramps-1 = ""
ramps-2 = ""
ramps-foreground = ${colors.celeste}

[module/network]
type = internal/network
interface-type = wired
interval = 3.0
format-connected = <label-connected>
format-connected-prefix = "󰤨 "
format-connected-prefix-foreground = ${colors.fuchsia}
format-connected-background = ${colors.background-chip}
format-connected-padding = 2
label-connected = %netspeed%

format-disconnected = <label-disconnected>
format-disconnected-prefix = "󰤭 "
format-disconnected-prefix-foreground = ${colors.alert}
format-disconnected-background = ${colors.background-chip}
format-disconnected-padding = 2
label-disconnected = Disconnected

[module/battery]
type = internal/battery
full-at = 99
low-at = 15
battery = BAT0
adapter = ADP1
poll-interval = 5

format-charging = <animation-charging> <label-charging>
format-charging-background = ${colors.background-chip}
format-charging-padding = 2
label-charging = %percentage%%

format-discharging = <ramps> <label-discharging>
format-discharging-background = ${colors.background-chip}
format-discharging-padding = 2
label-discharging = %percentage%%

ramps-0 = ""
ramps-1 = ""
ramps-2 = ""
ramps-foreground = ${colors.celeste}

animation-charging-0 = ""
animation-charging-1 = ""
animation-charging-2 = ""
animation-charging-foreground = ${colors.fuchsia}
animation-charging-framerate = 750

[module/powermenu]
type = custom/script
exec = echo ""
click-left = ~/.config/rofi/powermenu/type-1/powermenu.sh
format-background = ${colors.fuchsia}
format-foreground = #000000
format-padding = 2
