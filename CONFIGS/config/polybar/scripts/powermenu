#!/bin/bash

rofi_command="rofi -theme $HOME/.config/polybar/scripts/themes/powermenu.rasi"

uptime=$(uptime -p | sed -e 's/up //g')

# Options (icon-only for clean grid)
lock="󰌾"
logout="󰍃"
suspend="󰤄"
reboot="󰜉"
shutdown="⏻"

options="$lock\n$logout\n$suspend\n$reboot\n$shutdown"

chosen="$(echo -e "$options" | $rofi_command -p "  $uptime" -dmenu -selected-row 0)"
case $chosen in
    "$lock")
        i3lock
        ;;
    "$logout")
        bspc quit
        ;;
    "$suspend")
        mpc -q pause 2>/dev/null
        amixer set Master mute 2>/dev/null
        systemctl suspend
        ;;
    "$reboot")
        systemctl reboot
        ;;
    "$shutdown")
        systemctl poweroff
        ;;
esac

