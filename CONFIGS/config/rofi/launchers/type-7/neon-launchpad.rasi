/* App drawer layout based on the complete Rofi layouts in gh0stzk/dotfiles. */
@import "../../themes/shared.rasi"

configuration {
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "Apps";
    drun-display-format: "{name}";
}

window {
    width: 38%;
    height: 68%;
    border-color: @cyan;
    border-radius: 14px;
}

mainbox { padding: 16px; children: [ "inputbar", "listview" ]; }
prompt { background-color: @fuchsia; }
entry { placeholder: "Buscar aplicaciones"; }
listview { lines: 10; spacing: 6px; }
element { padding: 10px 12px; }
element selected.normal { background-color: @selected; border-color: @fuchsia; }
element-icon { size: 24px; }
