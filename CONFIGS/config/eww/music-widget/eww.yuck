;; Music Widget (adaptado de abod8639/eww-music-widget)

;; --- Listeners & Polls ---
(deflisten mw_song_title :initial "No Music Playing"
  "playerctl metadata --format '{{title}}' --follow 2>/dev/null || echo 'No Music Playing'")

(deflisten mw_song_artist :initial "Unknown Artist"
  "playerctl metadata --format '{{artist}}' --follow 2>/dev/null || echo 'Unknown Artist'")

(deflisten mw_player_status :initial "Stopped"
  "playerctl metadata --format '{{status}}' --follow 2>/dev/null || echo 'Stopped'")

(defpoll mw_song_length_s :interval "2s"
  "playerctl metadata mpris:length 2>/dev/null | awk '{print $1 / 1000000}' || echo 1")

(defpoll mw_song_position_s :interval "1s"
  "playerctl position 2>/dev/null || echo 0")

(defpoll mw_formatted_position :interval "1s"
  "playerctl position -f '{{duration(position)}}' 2>/dev/null || echo '0:00'")

(defpoll mw_cover_art_path :interval "1s"
  "$HOME/.config/eww/music-widget/get-cover.sh")

(defpoll mw_volume_percent :interval "2s"
  "$HOME/.config/eww/music-widget/volumecontroller.sh get")

(defpoll mw_volume_mute :interval "2s"
  "pamixer --get-mute 2>/dev/null || echo false")

(deflisten mw_cava :initial "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁"
  "bash $HOME/.config/scripts/eww_cava.sh 2>/dev/null || bash $HOME/.config/eww/music-widget/cava.sh 2>/dev/null || while true; do echo '▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁'; sleep 1; done")

;; --- Widget Definition ---
(defwidget music-widget []
  (box :class "mw-widget" :orientation "h" :space-evenly false
    (box :class "mw-cover" :style "background-image: url('${mw_cover_art_path}');")
    (box :class "mw-info" :orientation "v" :space-evenly false
      (label :class "mw-title" :text mw_song_title :limit-width 25)
      (label :class "mw-artist" :text mw_song_artist :limit-width 25)

      (box :class "mw-controls" :orientation "h"
        (button :class "mw-ctrl-btn" :onclick "playerctl previous" "󰒮")
        (button :class "mw-ctrl-btn" :onclick "playerctl play-pause" {mw_player_status == "Playing" ? "󰏤" : "󰐊"})
        (button :class "mw-ctrl-btn" :onclick "playerctl next" "󰒭"))

      (label :class "mw-position" :text mw_formatted_position)

      (scale :class "mw-progress"
             :min 0
             :max mw_song_length_s
             :value mw_song_position_s
             :onchange "playerctl position {}")

      (label :class "mw-cava" :text {mw_cava != "" ? mw_cava : "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁"}))

    (box :class "mw-vol-box"
         :orientation "v"
         :spacing 20
         :space-evenly false
         :vexpand false
         :hexpand false
      (button :onclick "$HOME/.config/eww/music-widget/volumecontroller.sh mute"
              :class "mw-vol-icon"
              :style "color: ${mw_volume_mute == 'true' ? '#ff00ff' : '#00ffff'};"
              {mw_volume_mute == "true" ? "󰝟" : ""})
      (scale :class "mw-vol-scale"
             :flipped true
             :orientation "v"
             :max 100
             :min 0
             :value mw_volume_percent
             :onchange "$HOME/.config/eww/music-widget/volumecontroller.sh set {}"))))

;; --- Window Definition ---
(defwindow music-widget
  :monitor 0
  :geometry (geometry :x "5px"
                      :y "5px"
                      :width "470px"
                      :height "150px")
  :wm-ignore true
  (music-widget))
