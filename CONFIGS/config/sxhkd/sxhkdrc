#	bspc node -z {right -50 0,top 0 50,bottom 0 -50,left 50 0,right -50 0,top 0 50,bottom 0 -50,left 50 0}

# Expandir ventana / Mover borde hacia afuera
super + alt + {h,j,k,l,Left,Down,Up,Right}
	~/.config/bspwm/scripts/bspwm_resize expand {west,south,north,east,west,south,north,east}

# Contraer ventana / Mover borde hacia adentro
super + alt + shift + {h,j,k,l,Left,Down,Up,Right}
	~/.config/bspwm/scripts/bspwm_resize contract {west,south,north,east,west,south,north,east}

# move a floating window
super + shift + ctrl + {Left,Down,Up,Right,h,j,k,l}
	bspc node -v {-50 0,0 50,0 -50,50 0,-50 0,0 50,0 -50,50 0}

super + {_,shift + }r
	bspc node '@parent' -R {_,-}90

