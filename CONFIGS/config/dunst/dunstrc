# ==============================================================================
#  Dunst Notification Daemon Configuration - Neon Fuchsia & Celeste
#  Repository: Tnr1112/kalipwm (branch: design_changes)
# ==============================================================================

[global]
    font = JetBrainsMono Nerd Font 10
    allow_markup = true
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "340x6-20+50"
    transparency = 10
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    line_height = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    separator_color = frame
    startup_notification = false
    corner_radius = 8;

[urgency_low]
    background = "#0a0a0c"
    foreground = "#00f0ff"
    frame_color = "#00f0ff"
    timeout = 5

[urgency_normal]
    background = "#0a0a0c"
    foreground = "#ffffff"
    frame_color = "#ff2cf1"
    timeout = 8

[urgency_critical]
    background = "#2a0818"
    foreground = "#ff5555"
    frame_color = "#ff3366"
    timeout = 0
