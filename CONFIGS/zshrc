# Notificación cuando un comando largo termina
function notify-on-complete() {
    local cmd_duration=$1
    local last_cmd=$2
    # Notificar si el comando tardó más de 30 segundos
    if [[ $cmd_duration -gt 30 ]]; then
        notify-send "Terminal" "Comando completado: $last_cmd" 2>/dev/null
    fi
}

# Auto-ls después de cd
function chpwd() {
    emulate -L zsh
    ls -la --color=auto
}

