    load_omz_plugin "$plugin"
done

if command -v enable-fzf-tab >/dev/null 2>&1; then
    enable-fzf-tab
fi

export FZF_DEFAULT_OPTS='
    --color=fg:#c0caf5,bg:#1a1b26,hl:#bb9af7
    --color=fg+:#c0caf5,bg+:#292e42,hl+:#7dcfff
    --color=info:#7aa2f7,prompt:#7dcfff,pointer:#7dcfff
    --color=marker:#9ece6a,spinner:#9ece6a,header:#9ece6a
    --border rounded
    --preview-window=right:60%
'

if command -v fd &> /dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi

export FZF_CTRL_T_OPTS="--preview 'batcat --color=always --style=numbers --line-range=:500 {} 2>/dev/null || cat {}'"
export FZF_ALT_C_OPTS="--preview 'lsd -la --color=always {}'"

# Estilos FZF-Tab
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'lsd -la --color=always $realpath'
zstyle ':fzf-tab:complete:git-(add|diff|restore|switch|checkout):*' fzf-preview 'git diff $word || git status --short'
zstyle ':fzf-tab:complete:(-command-|-parameter-|-brace-parameter-|export|unset|bindkey)::*' fzf-preview 'echo ${(P)word}'

