# Crear directorio y entrar
function mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Copiar output de un comando al clipboard
function cpy() {
    "$@" | xclip -selection clipboard
    echo "✓ Output copiado al clipboard"
}

# Copiar contenido de archivo al clipboard
function cpf() {
    cat "$1" | xclip -selection clipboard
    echo "✓ Contenido de '$1' copiado al clipboard"
}

# Buscar en el historial con fzf
function hf() {
    local cmd=$(history | fzf --tac --no-sort | sed 's/^[ ]*[0-9]*[ ]*//')
    if [ -n "$cmd" ]; then
        print -z "$cmd"
    fi
}

# Buscar archivo y abrirlo con nvim
function vf() {
    local file=$(find . -type f 2>/dev/null | fzf --preview 'batcat --color=always --style=numbers --line-range=:500 {}')
    [ -n "$file" ] && nvim "$file"
}

# Buscar directorio y cd
function cdf() {
    local dir=$(find . -type d 2>/dev/null | fzf --preview 'lsd -la {}')
    [ -n "$dir" ] && cd "$dir"
}

# Mostrar puertos en uso
function ports() {
    if [ -z "$1" ]; then
        ss -tulnp | grep LISTEN
    else
        ss -tulnp | grep ":$1"
    fi
}

